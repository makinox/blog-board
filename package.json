{
  "name": "blog-board",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "fetch:remote": "node ./scripts/fetch-remote.js",
    "generate:previews": "node scripts/generateDefaultPreview.mjs && node scripts/generatePreviewImages.mjs",
    "generate:previews:force": "node scripts/generateDefaultPreview.mjs --force && node scripts/generatePreviewImages.mjs --force",
    "build": "bun fetch:remote && bun generate:previews && astro check && astro build",
    "deploy": "bun test --run && bun build && firebase deploy",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --silent",
    "check": "./scripts/check-code.sh",
    "setup-hooks": "./scripts/setup-hooks.sh",
    "pre-commit": "bun lint && bun test:run"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro": "7.4.5",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "daisyui": "^5.7.50",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "node-fetch": "^3.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "shiki": "3.8.1"
  }
}
